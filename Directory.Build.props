<Project>
  <PropertyGroup>
    <RootNamespace>BertoSoftware</RootNamespace>
	<TargetFrameworks>net48;netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <OptionStrict>On</OptionStrict>
    <Copyright>Roberto Faccani</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/berto82/DapperContext</RepositoryUrl>
    <IncludeSymbols>True</IncludeSymbols>
    <Authors>Roberto Faccani</Authors>
    <Company>Roberto Faccani</Company>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
	<PackageReleaseNotes>
		v1.2.0
		- Added support for .NET Standard 2.0
		- Replace Microsoft.Data.SQLite for recent vulnerability in SQLitePCLRaw.lib.e_sqlite3 with System.Data.SQLite nuget package. With this package only x64 platform is supported
	</PackageReleaseNotes>
  </PropertyGroup>
</Project>